{
  "note": "Query-string cases for E21 (assignee) and E22 (q). `query` is the raw query string. The token {A100} becomes 100 'A' characters and {A101} becomes 101. `fields` is null where the response has no field entry (the standard message only). Read by backend tests.",
  "e21": [
    {"name": "valid me", "query": "assignee=me", "status": 200},
    {"name": "missing assignee", "query": "", "status": 400, "fields": {"assignee": "Required."}},
    {"name": "empty assignee", "query": "assignee=", "status": 400, "fields": {"assignee": "Must be me."}},
    {"name": "uppercase ME", "query": "assignee=ME", "status": 400, "fields": {"assignee": "Must be me."}},
    {"name": "me with trailing space", "query": "assignee=me%20", "status": 400, "fields": {"assignee": "Must be me."}},
    {"name": "other user id", "query": "assignee=00000000-0000-0000-0000-000000000000", "status": 400, "fields": {"assignee": "Must be me."}},
    {"name": "repeated assignee", "query": "assignee=me&assignee=me", "status": 400, "fields": {"assignee": "Send one value."}},
    {"name": "unknown key alone", "query": "foo=bar", "status": 400, "fields": {"assignee": "Required."}},
    {"name": "unknown key beside valid assignee", "query": "assignee=me&foo=bar", "status": 400, "fields": null},
    {"name": "unknown key beside invalid assignee", "query": "assignee=you&foo=bar", "status": 400, "fields": {"assignee": "Must be me."}},
    {"name": "q is unknown for E21", "query": "assignee=me&q=x", "status": 400, "fields": null}
  ],
  "e22": [
    {"name": "valid q", "query": "q=card", "status": 200},
    {"name": "one character", "query": "q=a", "status": 200},
    {"name": "100 characters", "query": "q={A100}", "status": 200},
    {"name": "101 characters", "query": "q={A101}", "status": 400, "fields": {"q": "Must be at most 100 characters."}},
    {"name": "trimmed 100 characters", "query": "q=%20{A100}%20", "status": 200},
    {"name": "missing q", "query": "", "status": 400, "fields": {"q": "Required."}},
    {"name": "empty q", "query": "q=", "status": 400, "fields": {"q": "Required."}},
    {"name": "bare q key", "query": "q", "status": 400, "fields": {"q": "Required."}},
    {"name": "whitespace q", "query": "q=%20%20%09", "status": 400, "fields": {"q": "Required."}},
    {"name": "NUL character", "query": "q=%00", "status": 400, "fields": {"q": "Enter valid text."}},
    {"name": "NUL inside text", "query": "q=ab%00cd", "status": 400, "fields": {"q": "Enter valid text."}},
    {"name": "repeated q", "query": "q=a&q=b", "status": 400, "fields": {"q": "Send one value."}},
    {"name": "unknown key alone", "query": "foo=bar", "status": 400, "fields": {"q": "Required."}},
    {"name": "unknown key beside valid q", "query": "q=card&foo=bar", "status": 400, "fields": null},
    {"name": "unknown key beside invalid q", "query": "q=&foo=bar", "status": 400, "fields": {"q": "Required."}},
    {"name": "assignee is unknown for E22", "query": "q=card&assignee=me", "status": 400, "fields": null}
  ]
}
