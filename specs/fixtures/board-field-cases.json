      "email": "Must be text."
     }
    }
   },
   {
    "id": "email-null",
    "set": {
     "email": null
    },
    "drop": [],
    "expect": {
     "fields": {
      "email": "Required."
     }
    }
   },
   {
    "id": "email-missing",
    "set": {},
    "drop": [
     "email"
    ],
    "expect": {
     "fields": {
      "email": "Required."
     }
    }
   },
   {
    "id": "extra-key",
    "set": {
     "role": "admin"
    },
    "drop": [],
