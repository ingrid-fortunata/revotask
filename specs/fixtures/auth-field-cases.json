     "name": "A"
    },
    "drop": [],
    "expect": {
     "accepted": {
      "name": "A"
     }
    }
   },
   {
    "id": "name-80-chars",
    "set": {
     "name": {
      "repeat": "a",
      "times": 80
     }
    },
    "drop": [],
    "expect": {
     "accepted": {
      "name": {
       "repeat": "a",
       "times": 80
      }
     }
    }
   },
   {
