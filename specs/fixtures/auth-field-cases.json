    "set": {
     "name": ""
    },
    "drop": [],
    "expect": {
     "fields": {
      "name": "Must be 1 to 80 characters."
     }
    }
   },
   {
    "id": "name-spaces-only",
    "set": {
     "name": "   "
    },
    "drop": [],
    "expect": {
     "fields": {
      "name": "Must be 1 to 80 characters."
     }
    }
   },
   {
    "id": "name-1-char",
