{
  "name": "revotask-frontend",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "browserslist": "> 1%",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:cleanup": "playwright test -c playwright.unit.config.ts cleanup",
    "e2e:unit": "playwright test -c playwright.unit.config.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "2.6.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "daisyui": "5.8.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
